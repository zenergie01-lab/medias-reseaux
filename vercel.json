{
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"livret-oracle-du-travail.pdf\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    { "source": "/livret", "destination": "/livret-oracle-du-travail.pdf", "permanent": false }
  ]
}
